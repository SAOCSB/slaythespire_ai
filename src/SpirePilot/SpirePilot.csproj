<Project Sdk="Microsoft.NET.Sdk">
  <!--
    SpirePilot — Slay the Spire 2 AI pilot mod.

    Game references come from one of two places (property Sts2RefSource):
      game  : the DLLs of a local Slay the Spire 2 install (default when one is found). Point at it with
              -p:Sts2Dir="C:/Program Files (x86)/Steam/steamapps/common/Slay the Spire 2" or a local.props file.
      nuget : community reference assemblies (no install needed; used by CI).
    Game version (property Sts2GameVersion): 0.111 (public beta, default) or 0.107 (Steam main branch). A newer branch
    (e.g. 0.112) builds as 0.111 code against a local install of that game.
    The two branches are not API compatible; code that differs is under #if STS2_V0107 / STS2_V0111.
    The build never copies game assemblies into the output.

    Build + install into the game's mods folder:  dotnet build -c Release -p:DeployToGame=true
  -->
  <Import Project="local.props" Condition="Exists('local.props')" />

  <PropertyGroup>
    <AssemblyName>SpirePilot</AssemblyName>
    <RootNamespace>SpirePilot</RootNamespace>
    <Version>$(SpirePilotVersion)</Version>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- The game references nullable-unaware assemblies; keep warnings readable. -->
    <NoWarn>$(NoWarn);CS8618;CS8600;CS8602;CS8603;CS8604;CS8625</NoWarn>
  </PropertyGroup>

  <!-- ===== locate the game ===== -->
  <PropertyGroup Condition="'$(Sts2Dir)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">
    <Sts2Dir Condition="Exists('C:/Program Files (x86)/Steam/steamapps/common/Slay the Spire 2')">C:/Program Files (x86)/Steam/steamapps/common/Slay the Spire 2</Sts2Dir>
    <Sts2Dir Condition="'$(Sts2Dir)' == '' and Exists('D:/SteamLibrary/steamapps/common/Slay the Spire 2')">D:/SteamLibrary/steamapps/common/Slay the Spire 2</Sts2Dir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Sts2Dir)' == '' and $([MSBuild]::IsOSPlatform('Linux'))">
    <Sts2Dir Condition="Exists('$(HOME)/.local/share/Steam/steamapps/common/Slay the Spire 2')">$(HOME)/.local/share/Steam/steamapps/common/Slay the Spire 2</Sts2Dir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Sts2Dir)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">
    <Sts2Dir Condition="Exists('$(HOME)/Library/Application Support/Steam/steamapps/common/Slay the Spire 2')">$(HOME)/Library/Application Support/Steam/steamapps/common/Slay the Spire 2</Sts2Dir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Sts2DataDir)' == '' and '$(Sts2Dir)' != ''">
    <Sts2DataDir Condition="Exists('$(Sts2Dir)/data_sts2_windows_x86_64/sts2.dll')">$(Sts2Dir)/data_sts2_windows_x86_64</Sts2DataDir>
    <Sts2DataDir Condition="'$(Sts2DataDir)' == '' and Exists('$(Sts2Dir)/data_sts2_linuxbsd_x86_64/sts2.dll')">$(Sts2Dir)/data_sts2_linuxbsd_x86_64</Sts2DataDir>
    <Sts2DataDir Condition="'$(Sts2DataDir)' == '' and Exists('$(Sts2Dir)/SlayTheSpire2.app/Contents/Resources/data_sts2_macos_arm64/sts2.dll')">$(Sts2Dir)/SlayTheSpire2.app/Contents/Resources/data_sts2_macos_arm64</Sts2DataDir>
    <Sts2DataDir Condition="'$(Sts2DataDir)' == '' and Exists('$(Sts2Dir)/SlayTheSpire2.app/Contents/Resources/data_sts2_macos_x86_64/sts2.dll')">$(Sts2Dir)/SlayTheSpire2.app/Contents/Resources/data_sts2_macos_x86_64</Sts2DataDir>
  </PropertyGroup>
  <PropertyGroup>
    <Sts2GameVersion Condition="'$(Sts2GameVersion)' == ''">0.111</Sts2GameVersion>
    <DefineConstants Condition="'$(Sts2GameVersion)' == '0.107'">$(DefineConstants);STS2_V0107</DefineConstants>
    <DefineConstants Condition="'$(Sts2GameVersion)' != '0.107'">$(DefineConstants);STS2_V0111</DefineConstants>
    <Sts2MinGameVersion Condition="'$(Sts2GameVersion)' == '0.107'">0.107.1</Sts2MinGameVersion>
    <Sts2MinGameVersion Condition="'$(Sts2GameVersion)' != '0.107'">0.111.0</Sts2MinGameVersion>
    <Sts2RefPackageVersion Condition="'$(Sts2GameVersion)' == '0.107'">0.107.1</Sts2RefPackageVersion>
    <Sts2RefPackageVersion Condition="'$(Sts2GameVersion)' != '0.107'">0.111.0-beta-41cef1ea</Sts2RefPackageVersion>
    <Sts2RefSource Condition="'$(Sts2RefSource)' == '' and '$(Sts2DataDir)' != '' and Exists('$(Sts2DataDir)/sts2.dll')">game</Sts2RefSource>
    <Sts2RefSource Condition="'$(Sts2RefSource)' == ''">nuget</Sts2RefSource>
    <Sts2ModsDir Condition="'$(Sts2ModsDir)' == '' and '$(Sts2Dir)' != ''">$(Sts2Dir)/mods</Sts2ModsDir>
  </PropertyGroup>

  <ItemGroup Condition="'$(Sts2RefSource)' == 'game'">
    <Reference Include="sts2"><HintPath>$(Sts2DataDir)/sts2.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="GodotSharp"><HintPath>$(Sts2DataDir)/GodotSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(Sts2DataDir)/0Harmony.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <!-- Public-API reference assemblies of sts2.dll / GodotSharp.dll / 0Harmony.dll for the chosen game version. -->
  <ItemGroup Condition="'$(Sts2RefSource)' == 'nuget'">
    <PackageReference Include="BSchneppe.Sts2.ReferenceAssemblies" Version="$(Sts2RefPackageVersion)" PrivateAssets="all" />
  </ItemGroup>

  <!-- The branch the version guard reports as compiled for (Diagnostics.CompiledFor). -->
  <ItemGroup>
    <AssemblyMetadata Include="Sts2GameVersion" Value="$(Sts2GameVersion)" />
  </ItemGroup>

  <!-- Game-independent core, compiled into this assembly (the game loads one DLL per mod). -->
  <ItemGroup>
    <Compile Include="../SpirePilot.Core/**/*.cs" Exclude="../SpirePilot.Core/obj/**;../SpirePilot.Core/bin/**" LinkBase="Core" />
  </ItemGroup>

  <!-- The reference packages exist for the shipped branches only; a newer branch needs the game's own DLLs. -->
  <Target Name="CheckSts2GameVersion" BeforeTargets="CoreCompile" Condition="'$(Sts2RefSource)' == 'nuget' and '$(Sts2GameVersion)' != '0.107' and '$(Sts2GameVersion)' != '0.111'">
    <Error Text="No reference package for game $(Sts2GameVersion) (only 0.107 and 0.111): build against that game's install with -p:Sts2Dir=&quot;path to Slay the Spire 2&quot;." />
  </Target>

  <!-- One manifest per game branch so min_game_version always matches the API the DLL was compiled against.
       (UTF-8 without BOM; copied byte for byte.) Keep "version" in sync with SpirePilotVersion. A newer branch built
       from source before it has a manifest of its own takes the newest one: older games then load the DLL, and the
       version guard keeps the AI off on them. -->
  <Target Name="WriteModManifest" AfterTargets="Build">
    <PropertyGroup>
      <Sts2Manifest>$(MSBuildProjectDirectory)/manifest/mod_manifest.$(Sts2GameVersion).json</Sts2Manifest>
      <Sts2Manifest Condition="!Exists('$(Sts2Manifest)')">$(MSBuildProjectDirectory)/manifest/mod_manifest.0.111.json</Sts2Manifest>
    </PropertyGroup>
    <Copy SourceFiles="$(Sts2Manifest)" DestinationFiles="$(TargetDir)mod_manifest.json" />
  </Target>

  <!-- Copy the built mod into <game>/mods/SpirePilot when -p:DeployToGame=true. -->
  <Target Name="DeployToGame" AfterTargets="WriteModManifest" Condition="'$(DeployToGame)' == 'true'">
    <Error Condition="'$(Sts2ModsDir)' == ''" Text="Cannot deploy: set -p:Sts2Dir=&quot;path to Slay the Spire 2&quot;." />
    <MakeDir Directories="$(Sts2ModsDir)/SpirePilot" />
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).dll;$(TargetDir)mod_manifest.json" DestinationFolder="$(Sts2ModsDir)/SpirePilot" />
    <Message Importance="high" Text="SpirePilot deployed to $(Sts2ModsDir)/SpirePilot" />
  </Target>
</Project>
